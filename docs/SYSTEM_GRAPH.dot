digraph ODPAR {
  rankdir=LR;
  graph [fontname="sans-serif", bgcolor="white"];
  node [shape=box, style="rounded,filled", fillcolor="#f7f7f7", fontname="sans-serif"];
  edge [fontname="sans-serif", fontsize=9];
  "platform" [label="platform\nPlatform + deterministic memory", fillcolor="#f7f7f7"];
  "entity_store" [label="entity_store\nDynamic entity stores + spatial index", fillcolor="#f7f7f7"];
  "game_api" [label="game_api\nPublic C API + ABI", fillcolor="#f7f7f7"];
  "items" [label="items\nItems + capabilities", fillcolor="#f7f7f7"];
  "registry" [label="registry\nCross-registry validation", fillcolor="#e8ffe8"];
  "territory_policy" [label="territory_policy\nTerritorial access policy", fillcolor="#f7f7f7"];
  "surface" [label="surface\nTerrain + water + biome + weather authority", fillcolor="#e8f7ff"];
  "world_physics" [label="world_physics\nShared terrain height + occupancy + airspace physics", fillcolor="#f7f7f7"];
  "geology" [label="geology\nSubsurface strata + caves + ore-body authority", fillcolor="#f7f7f7"];
  "survival" [label="survival\nRespiration + persistent environmental survival state", fillcolor="#f7f7f7"];
  "nutrition" [label="nutrition\nFood + satiety + hydration + gradual damage", fillcolor="#f7f7f7"];
  "fluids" [label="fluids\nFluid registry + typed containers", fillcolor="#f7f7f7"];
  "flora" [label="flora\nFlora lifecycle + fruit + seed + irrigation", fillcolor="#f7f7f7"];
  "fauna" [label="fauna\nFauna lifecycle + habitat + diet + reproduction", fillcolor="#f7f7f7"];
  "interactions" [label="interactions\nPlayer/bot interaction dispatch", fillcolor="#f7f7f7"];
  "construction" [label="construction\nLightweight territorial construction modules", fillcolor="#f7f7f7"];
  "artifacts" [label="artifacts\nStations + storage + death recovery", fillcolor="#f7f7f7"];
  "crafting" [label="crafting\nRecipes + repair + material progression", fillcolor="#f7f7f7"];
  "persistence" [label="persistence\nSave/load + persistent world state", fillcolor="#f7f7f7"];
  "map" [label="map\nMap queries + spatial world inspection", fillcolor="#f7f7f7"];
  "simulation" [label="simulation\nActors + bots + territory + combat + movement", fillcolor="#ffe7e7"];
  "renderer" [label="renderer\nNative 3D presentation", fillcolor="#f7f7f7"];
  "textures" [label="textures\nTexture/skin presentation store", fillcolor="#f7f7f7"];
  "music" [label="music\nMusic reactive presentation", fillcolor="#f7f7f7"];
  "flutter_host" [label="flutter_host\nFlutter/Dart APK host", fillcolor="#dfefff"];
  "wasm_host" [label="wasm_host\nWASM preview host", fillcolor="#fff2d9"];
  "spine" [label="spine\nProject contract manifest", fillcolor="#eeeeee"];
  "architecture_guards" [label="architecture_guards\nArchitecture anti-coupling guards", fillcolor="#f7f7f7"];
  "registry" -> "items" [label="all registered content references valid item identities/capabilities"];
  "flora" -> "surface" [label="growth/irrigation use the same terrain moisture authority"];
  "flora" -> "territory_policy" [label="wild flora is exploitable only with territorial access"];
  "fauna" -> "surface" [label="spawn/migration/foraging/drinking are constrained by the authoritative habitat surface"];
  "fauna" -> "items" [label="diets and loot resolve item identities"];
  "nutrition" -> "items" [label="food is item-driven, not flora-specific"];
  "interactions" -> "nutrition" [label="consume action uses generic food authority"];
  "interactions" -> "flora" [label="gather/plant/irrigate enter through interaction dispatcher"];
  "interactions" -> "fauna" [label="hunting/taming interaction reaches fauna authority"];
  "simulation" -> "surface" [label="movement uses terrain authority rather than renderer geometry"];
  "simulation" -> "nutrition" [label="actor survival ticks through generic nutrition"];
  "simulation" -> "fauna" [label="fauna lifecycle runs in authoritative world tick"];
  "simulation" -> "flora" [label="flora lifecycle runs in authoritative world tick"];
  "simulation" -> "artifacts" [label="death can create persistent recovery container"];
  "renderer" -> "surface" [label="visual ground/water/orientation use same terrain height/normal"];
  "persistence" -> "entity_store" [label="save/load restores dynamic stores transactionally"];
  "flutter_host" -> "fauna" [label="APK consumes fauna + nest snapshots and habitat definitions"];
  "flutter_host" -> "surface" [label="APK can inspect authoritative terrain/weather state"];
  "flutter_host" -> "nutrition" [label="APK exposes actor satiety/hydration without duplicating survival rules"];
  "flutter_host" -> "simulation" [label="APK sees non-lethal trail-break state"];
  "wasm_host" -> "game_api" [label="preview export surface is derived from native ABI allowlist"];
  "persistence" -> "fauna" [label="fauna and nests survive save/load rather than respawning as decoration"];
  "persistence" -> "nutrition" [label="actor HP/satiety/trail recovery survive save/load"];
  "persistence" -> "surface" [label="weather epoch/rain state survives save/load"];
  "persistence" -> "territory_policy" [label="claimed territory survives save/load"];
  "flutter_host" -> "persistence" [label="APK stores independent named world slots, verifies integrity, and asks the C save-schema authority whether a world is loadable; API/ABI are provenance only"];
  "architecture_guards" -> "flora" [label="transversal gameplay cannot hardcode concrete flora species/items"];
  "registry" -> "fluids" [label="fluid/container registries are cross-validated before world start"];
  "nutrition" -> "fluids" [label="actor drinking resolves typed fluids/containers through the fluid registry"];
  "interactions" -> "fluids" [label="fill/drink/irrigate dispatch uses typed fluid payloads and container capabilities"];
  "simulation" -> "fluids" [label="bot survival drinks real carried fluids and navigates to physical water sources"];
  "flutter_host" -> "fluids" [label="APK consumes fluid and container definitions from the C authority"];
  "geology" -> "surface" [label="cave mouths and subsurface depth are anchored to the authoritative surface/water world"];
  "flora" -> "geology" [label="surface mineral exposures are materialized only when backed by deterministic subsurface ore bodies"];
  "survival" -> "surface" [label="respiration queries authoritative water depth instead of renderer state"];
  "simulation" -> "survival" [label="respiration and environmental damage advance in the authoritative world tick"];
  "persistence" -> "survival" [label="worldgen version and respiration state survive save/load through save schema migrations"];
  "flutter_host" -> "survival" [label="APK reads oxygen/worldgen state from C without duplicating survival rules"];
  "flutter_host" -> "geology" [label="APK can inspect authoritative cave/ore strata through the C API"];
  "registry" -> "construction" [label="construction content/profile consistency is validated at registry initialization"];
  "construction" -> "territory_policy" [label="placement and dismantling rights derive from territorial control"];
  "construction" -> "surface" [label="construction placement rejects water/steep invalid surfaces"];
  "interactions" -> "construction" [label="universal interaction dispatch places and dismantles lightweight construction"];
  "world_physics" -> "construction" [label="shared world occupancy treats lightweight construction as physical geometry"];
  "persistence" -> "construction" [label="save20 persists compact construction topology and durability while explicit migrations preserve legacy artifact-backed blocks"];
  "renderer" -> "construction" [label="native renderer draws authoritative compact construction state"];
  "world_physics" -> "surface" [label="shared terrain physics interpolates deterministic global world height"];
  "simulation" -> "world_physics" [label="actor movement and camera consume shared physical occupancy geometry"];
}
